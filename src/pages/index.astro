						</button>
						<div> <img src={assetSrc(eyewearImage)} alt="Smart Eyewear for Visually Impaire Individuals" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">Smart Eyewear for Visually Impaire Individuals</p> </div>
					</div>
				</div>

				<div id="credentials" class="snap-section my-6 sm:my-10 md:my-14 lg:my-20">
