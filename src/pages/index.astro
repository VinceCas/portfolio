---
import '../styles/global.css';
import profileFrameOne from '../assets/profile_transfrom/the-grey-background-slowly-transitions-to-a-solid-_001.png';
import javascriptLogo from '../assets/logos/javascript.svg';
import reactLogo from '../assets/logos/react.svg';
import bootstrapLogo from '../assets/logos/bootstrap.svg';
import tailwindLogo from '../assets/logos/tailwind.svg';
import nodeLogo from '../assets/logos/node.svg';
import laravelLogo from '../assets/logos/laravel.svg';
import pythonLogo from '../assets/logos/python.svg';
import csharpLogo from '../assets/logos/csharp.svg';
import javaLogo from '../assets/logos/java.svg';
import mysqlLogo from '../assets/logos/mysql.svg';
import mongodbLogo from '../assets/logos/mongodb.svg';
import figmaLogo from '../assets/logos/figma.svg';
import gitLogo from '../assets/logos/git.svg';
import websiteImage from '../assets/images/website.png';
import gameImage from '../assets/images/game.png';
import eyewearImage from '../assets/images/eyewear.png';
import eosTrailer from '../assets/video/EOS Trailer (long ver.).mp4';
import linkedinLogo from '../assets/logos/linkedin.svg';
import githubLogo from '../assets/logos/github.svg';
import facebookLogo from '../assets/logos/facebook.svg';
import gmailLogo from '../assets/logos/gmail.svg';
import phoneLogo from '../assets/logos/phone.svg';

type AssetSource = string | { src: string };
const assetSrc = (asset: AssetSource) => typeof asset === 'string' ? asset : asset.src;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Vincent Casuga</title>
		<script>
			import '../scripts/theme-toggle.js';
		</script>
		<script src="//code.tidio.co/xnsbf6xdmvv90ikpvg3rr7ekrlcpfmew.js" async></script>
	</head>

	

	<body class="m-0 p-0 overflow-x-hidden">

		<div class="snap-section">
			<div class="w-full overflow-hidden">
				<h1 
					class="text-black font-bold text-[27vw] tracking-[-0.12em] leading-[0.8] whitespace-nowrap m-0 p-0">
					CASUGA
				</h1>
			</div>

			<section class="minimal-3d-section" aria-label="Interactive 3D portfolio mark">
				<canvas id="minimal-3d-canvas"></canvas>
			</section>
		</div>


		<div class="mx-8 mt-8 sm:mx-34 sm:mt-16 md:mx-37 md:mt-14 lg:mt-16 lg:mx-[180px] xl:mx-[280px] 2xl:mx-[520px] xl:mt-[100px]">
			<div id="main_div" class="flex flex-col gap-10">

				<div class="snap-section">
				<div id="profile" class="grid grid-cols-3 gap-0 m-0 p-0">
					<div class="m-0 p-0">
						<img
							id="profile-image"
							src={assetSrc(profileFrameOne)}
							alt="Vincent Casuga"
							class="w-auto object-cover"
						>
					</div>
					<div class="col-span-2 flex flex-col justify-between pl-2 sm:pl-4">
						<div class="space-y-0">
							<div class="flex items-start justify-between gap-2">
								<h2 class="text-black text-[13px] sm:text-[20px] md:text-[28px] lg:text-[34px] xl:text-[40px] font-bold">Vincent Josh Casuga</h2>
								<button
									id="theme-toggle"
									class="theme-toggle"
									type="button"
									aria-label="Switch to night mode"
									aria-pressed="false"
									title="Toggle night mode"
								>
									<svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<circle cx="12" cy="12" r="4"></circle>
										<path d="M12 2v2"></path>
										<path d="M12 20v2"></path>
										<path d="m4.93 4.93 1.41 1.41"></path>
										<path d="m17.66 17.66 1.41 1.41"></path>
										<path d="M2 12h2"></path>
										<path d="M20 12h2"></path>
										<path d="m6.34 17.66-1.41 1.41"></path>
										<path d="m19.07 4.93-1.41 1.41"></path>
									</svg>
									<svg class="moon-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M21 14.3A8.8 8.8 0 0 1 9.7 3a7 7 0 1 0 11.3 11.3z"></path>
									</svg>
								</button>
							</div>
							<p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[17px] xl:text-[18px] inline-flex items-center gap-0.5 flex-wrap">
								<svg viewBox="0 0 24 24" class="h-[1em] w-[1em] text-black shrink-0" fill="currentColor" aria-hidden="true">
									<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/>
								</svg>
								City of San Jose Del Monte, Bulacan
							</p>
							<p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[17px] xl:text-[18px] pt-1 md:pt-3 lg:pt-5">Bachelor of Science in Computer Science</p>
