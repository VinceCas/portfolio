						<div class="bg-[#E8E8E8] px-9 py-5 hover:bg-[#d4d4d4] transition-colors duration-300"> 
							<a href="https://catalog-education.oracle.com/ords/certview/sharebadge?id=49EBD669872ECE576276914FC27CB479B500028469EAB4858183F04282D6A0EE" target="_blank">
							<p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-start font-bold">
								Oracle Cloud Infrastructure 2025 Certified Foundations Associate
							</p> 
							<p class="text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px]">Oracle</p>
							</a>
						</div>

						<div class="bg-[#E8E8E8] px-9 py-5 hover:bg-[#d4d4d4] transition-colors duration-300"> 
							<a href="https://www.credly.com/badges/4642a2f1-df3b-4d8d-a410-7b8222656c70/linked_in_profile" target="_blank">
							<p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-start font-bold">
