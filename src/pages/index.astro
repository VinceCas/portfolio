								</svg>
								Email
							</a>
							<a title="09954536797" href="javascript:void(0)" 
								onclick="navigator.clipboard.writeText('+639954536797').then(() => { const textSpan = document.getElementById('btn-text'); textSpan.innerText = 'Copied'; setTimeout(() => { textSpan.innerText = 'Call'; }, 2000); })"
