						<div> <img src={assetSrc(reactLogo)} alt="React" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">React</p> </div>
						<div> <img src={assetSrc(bootstrapLogo)} alt="Bootstrap" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">Bootstrap</p> </div>
