		<script>
		    window.addEventListener('keydown', function(e) {
				// Prevent spacebar from scrolling the page when focused on interactive elements
		        const activeTag = document.activeElement ? document.activeElement.tagName.toUpperCase() : '';
		        if (e.code === 'Space' && (activeTag === 'IFRAME' || activeTag === 'INPUT' || activeTag === 'TEXTAREA')) {
		            e.stopPropagation();
		        }
		    }, { capture: true, passive: false }); 
		</script>
