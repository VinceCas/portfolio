					</div>

					<p class="text-black font-bold text-[9px] sm:text-[13px] md:text-[15px] lg:text-[17px] xl:text-[18px] ml-3 sm:ml-6 md:ml-10 lg:ml-15 mt-3 sm:mt-5 md:mt-8 lg:mt-12">Backend</p>
					<div class="grid grid-cols-4 sm:grid-cols-6 gap-10 ml-3 sm:ml-6 md:ml-10 lg:ml-15 mt-3 md:mt-6">
						<div> <img src={assetSrc(nodeLogo)} alt="Node.js" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">Node.js</p> </div>
						<div> <img src={assetSrc(laravelLogo)} alt="Laravel" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">Laravel</p> </div>
						<div> <img src={assetSrc(pythonLogo)} alt="Python" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">Python</p> </div>
						<div> <img src={assetSrc(csharpLogo)} alt="C#" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">C#</p> </div>
						<div> <img src={assetSrc(javaLogo)} alt="Java" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">Java</p> </div>
						<div> <img src={assetSrc(mysqlLogo)} alt="MySQL" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">MySQL</p> </div>
						<div> <img src={assetSrc(mongodbLogo)} alt="MongoDB" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">MongoDB</p> </div>
