						<div> <img src={assetSrc(figmaLogo)} alt="Figma" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">Figma</p> </div>
						<div> <img src={assetSrc(gitLogo)} alt="Git" class="w-full object-cover"> <p class="text-black text-[9px] sm:text-[13px] md:text-[15px] lg:text-[18px] text-center">Git</p> </div>
